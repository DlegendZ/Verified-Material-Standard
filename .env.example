# =============================================================================
# VMS — contoh environment variable
#
# Salin file ini jadi `.env.local`, lalu isi nilainya.
#   cp .env.example .env.local
#
# File .env.local / .env TIDAK pernah disentuh agent dan tidak pernah di-commit
# (lihat .gitignore). Semua konfigurasi lewat env — tidak ada nilai rahasia di
# dalam kode (SRD Bab 12.2, 12-factor).
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# URL project Supabase — cukup origin-nya saja, TANPA /rest/v1 di belakang.
# Benar : https://<ref>.supabase.co
# Salah : https://<ref>.supabase.co/rest/v1
# Lokal (supabase start): http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Anon key — aman dipakai di browser, dibatasi Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — HANYA untuk server (seed demo, render PDF/QR sertifikat,
# signed URL dokumen). JANGAN diawali NEXT_PUBLIC_ dan jangan dipakai di client.
SUPABASE_SERVICE_ROLE_KEY=

# Connection string Postgres, dipakai skrip seed demo & migrasi manual.
# Lokal default: postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_DB_URL=

# --- Aplikasi ---------------------------------------------------------------
# URL absolut aplikasi. Dipakai untuk isi QR code & Open Graph halaman
# verifikasi publik, jadi harus bisa diakses dari HP yang melakukan scan.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Masa berlaku sertifikat dalam hari (keputusan D2, default 90).
CERTIFICATE_VALIDITY_DAYS=90
