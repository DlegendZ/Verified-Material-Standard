/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# contoh env WAJIB ikut ter-commit; file env asli tidak pernah
!.env.example

# artefak Claude Code — hanya untuk kerja lokal, jangan ikut ke GitHub
CLAUDE.md
CLAUDE.local.md
.claude/
.claude*/
.mcp.json

# kredensial & rahasia
*.key
*.pem
*.p12
*.pfx
secrets/
credentials*.json
service-account*.json

# hasil test & build tool
/playwright-report/
/test-results/
/.playwright/
